# ==============================================
# ClickUp
# ==============================================

# Personal API token generated at: ClickUp -> profile -> Apps -> API Token
CLICKUP_API_TOKEN=

# ID of the ClickUp Team (Workspace) the pipeline reads from
CLICKUP_TEAM_ID=

# ID of the ClickUp List (the project) the pipeline syncs tasks from
CLICKUP_LIST_ID=

# ID of the "Area" drop-down custom field in ClickUp (found via the field's
# details in the ClickUp UI, or GET /list/{list_id}/field)
CLICKUP_AREA_FIELD_ID=

# ==============================================
# Clockify
# ==============================================

# API key generated at: Clockify -> profile -> Preferences -> API
API_KEY_CLOCKIFY=

# Clockify workspace ID
WORKSPACE_ID=

# Workspace name (optional, informational only)
WORKSPACE_NAME=

# ==============================================
# Postgres / Supabase
# ==============================================

# SQLAlchemy connection string, format: postgresql+psycopg://user:password@host:port/database
# Use Supabase's transaction pooler (port 6543), not the direct connection: the
# pooler supports IPv4, while the direct connection only answers on IPv6, which
# breaks on networks and providers without IPv6 support.
DATABASE_URL=

# ==============================================
# Alert rules (priority x deadline)
# ==============================================

# Low priority: trigger alert when N days or fewer remain until the deadline
ALERT_DAYS_LOW=3

# High priority: trigger alert when N days or fewer remain until the deadline
ALERT_DAYS_HIGH=5

# Medium priority: trigger alert when N days or fewer remain until the deadline
ALERT_DAYS_MEDIUM=4

# Priority labels treated as high / low by the alert rules (JSON lists)
HIGH_PRIORITIES=["Highest", "High"]
LOW_PRIORITIES=["Low", "Lowest"]

# ==============================================
# Microsoft Teams - Webhooks per area (Power Automate)
# ==============================================

# Each area channel has its own workflow/webhook URL in Teams
WEBHOOK_TI=
WEBHOOK_SOP=
WEBHOOK_IA=
WEBHOOK_FRONT=
WEBHOOK_DESIGN=
WEBHOOK_DATA=
WEBHOOK_BACK=

# Fallback channel used when a task has no area, or the area has no dedicated channel
WEBHOOK_NO_AREA=

# ==============================================
# Backblaze B2 (spreadsheet storage)
# ==============================================

# Bucket endpoint (e.g. https://s3.us-east-005.backblazeb2.com)
B2_ENDPOINT_URL=

# Name of the bucket created in Backblaze
B2_BUCKET_NAME=

# Application Key generated at: Backblaze -> Application Keys
B2_APPLICATION_KEY=

# Key ID matching the Application Key
B2_KEY_ID=

# File name inside the bucket (the "object" representing the spreadsheet)
EXCEL_CLOUD_NAME=QuimiaGestao.xlsx

# Local temp path used while the pipeline runs (never commit this file)
TEMP_EXCEL_PATH=planilha_temp.xlsx

# ==============================================
# Sentry (error monitoring)
# ==============================================

# DSN of the project created at sentry.io
SENTRY_DSN=

# ==============================================
# Better Stack (logs + heartbeat)
# ==============================================

# Heartbeat URL, obtained when creating a Heartbeat in the Better Stack dashboard
BETTERSTACK_HEARTBEAT_URL=

# Source token, obtained when creating a Source in Better Stack
BETTERSTACK_SOURCE_TOKEN=

# Ingesting host specific to your Source (shown next to the token)
BETTERSTACK_INGESTING_HOST=